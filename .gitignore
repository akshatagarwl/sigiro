AGENTS.md

# Blume's generated Astro project and build output.
docs-site/.blume/
docs-site/dist/
www/.source/

# Letta worktree admin state
.letta/

# Local service state from `nix run .#dev-services`: PostgreSQL and RustFS data
# and the locally issued TLS certificates and CA (nix/dev-services.nix).
.dev/

# Local Worker secrets and env overrides (wrangler/celld convention). These
# carry BETTER_AUTH_SECRET and must never be committed.
.dev.vars
.dev.vars.*

# celld's local runtime state (D1 sqlite, replication working dir).
.celld/

# Alchemy's local state and bundled worker output.
**/.alchemy/

# Local design-review screenshots (www/scripts/shoot-auth.ts)
.shots/

# Wrangler's local cache holds the account it last used; never commit it.
.wrangler/
# Local agent worktrees and per-user editor state.
.worktrees/

# Track the shared shell declaration; ignore its machine-local cache.
!/.envrc
/.direnv/

# Nix build output links (`nix build`).
/result
/result-*
