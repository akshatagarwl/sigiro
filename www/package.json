{
  "name": "www",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "alchemy:deploy": "ALCHEMY_STAGE=prod alchemy deploy ./alchemy.run.ts --yes",
    "alchemy:plan": "ALCHEMY_STAGE=prod alchemy plan ./alchemy.run.ts --no-input",
    "alchemy:hetzner:deploy": "ALCHEMY_STAGE=prod alchemy deploy ./alchemy.hetzner.run.ts --yes",
    "alchemy:hetzner:plan": "ALCHEMY_STAGE=prod alchemy plan ./alchemy.hetzner.run.ts --no-input",
    "alchemy:workload:deploy": "ALCHEMY_STAGE=prod alchemy deploy ./alchemy.workload.run.ts --yes",
    "alchemy:workload:plan": "ALCHEMY_STAGE=prod alchemy plan ./alchemy.workload.run.ts --no-input",
    "alchemy:dev:deploy": "ALCHEMY_STAGE=local alchemy deploy ./alchemy.dev.run.ts --yes --no-input",
    "alchemy:dev:destroy": "ALCHEMY_STAGE=local alchemy destroy ./alchemy.dev.run.ts --yes --no-input",
    "alchemy:dev:plan": "ALCHEMY_STAGE=local alchemy plan ./alchemy.dev.run.ts --no-input",
    "dev": "blume dev",
    "build": "blume build",
    "preview": "wrangler dev --config wrangler.preview.jsonc",
    "check:otp": "tsx scripts/check-otp-browser.ts",
    "check:signup": "tsx scripts/check-signup-browser.ts",
    "check:device": "tsx scripts/check-device-flow.ts",
    "check:mcp": "tsx scripts/check-mcp-contract.ts",
    "check:mcp:hosted": "tsx scripts/check-mcp-hosted.ts",
    "check:webmcp:browser": "aube run build && node scripts/check-webmcp-oauth.mjs",
    "check:dashboard": "node scripts/check-dashboard.mjs",
    "check:web": "aube run check:mcp && aube run check:mcp:hosted && aube run check:webmcp:browser",
    "deploy": "aube run alchemy:deploy",
    "check": "aube -C .. run fmt:check && aube -C .. run lint",
    "doctor": "blume doctor",
    "og": "tsx scripts/generate-og.tsx",
    "indexnow": "tsx scripts/indexnow.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/sitemap": "3.7.4",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nekuda/webmcp-sdk": "0.8.0",
    "apache-arrow": "17.0.0",
    "astro": "7.4.4",
    "blume": "2.2.6",
    "effect": "4.0.7",
    "input-otp": "1.5.0",
    "motion": "14.7.1",
    "oauth4webapi": "3.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0",
    "sigiro-icons": "npm:simple-icons@16.36.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@alchemy.run/docker": "2.0.0-beta.84",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
    "@alchemy.run/hetzner": "2.0.0-beta.84",
    "@effect/platform-node": "4.0.7",
    "@mcp-b/webmcp-polyfill": "6.0.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/og": "1.0.3",
    "alchemy": "2.0.0-beta.84",
    "geist": "1.8.2",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.1.0-dev.20260803.1",
    "wrangler": "4.154.0"
  },
  "packageManager": "aube@2.8.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "aube": {
    "patchedDependencies": {
      "astro@7.4.4": "patches/astro@7.4.4.patch"
    }
  }
}
