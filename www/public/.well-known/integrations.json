{
  "version": 3,
  "summary": "sigiro reads OpenTelemetry and answers what changed and why: ranked findings, the suspect deploy, and a runnable SQL query on every row. Reachable as a hosted HTTP API, a self-hosted binary serving the same API with no credential, a CLI, and a public documentation MCP server.",
  "credentials": {
    "tenant_key": {
      "type": "api_key",
      "label": "sigiro TenantKey",
      "setup": "Only the hosted service at `api.sigiro.com` needs a credential. During the invited beta an operator issues each tenant a key of the form `sk_<tenant>_<random>`; it is shown once and can be rotated but not recovered. The same key authorises both OTLP ingest and SQL queries. Send it as `Authorization: Bearer sk_<tenant>_<random>`.\n\n**A self-hosted sigiro needs no credential at all.** It runs in open mode and authenticates no request — the network is the security boundary, so put it behind a tailnet, private network or reverse proxy. A self-hosted server ignores authentication headers entirely, so a wrong key fails there silently rather than with a 401."
    }
  },
  "surfaces": [
    {
      "type": "http",
      "slug": "telemetry-api",
      "name": "sigiro hosted telemetry API",
      "url": "https://api.sigiro.com",
      "spec": "https://api.sigiro.com/openapi.json",
      "docs": "https://sigiro.com/docs/reference",
      "basis": {
        "via": "declared",
        "source": "https://sigiro.com/.well-known/integrations.json"
      },
      "auth": {
        "status": "required",
        "entries": [
          {
            "use": [
              {
                "id": "tenant_key",
                "mechanics": {
                  "source": "http",
                  "in": "header",
                  "headerName": "Authorization",
                  "scheme": "Bearer"
                }
              }
            ],
            "basis": {
              "via": "declared",
              "source": "https://sigiro.com/.well-known/integrations.json"
            }
          }
        ]
      }
    },
    {
      "type": "http",
      "slug": "self-hosted-api",
      "name": "sigiro self-hosted API (open mode)",
      "url": "https://<your-sigiro-host>:9999",
      "spec": "https://api.sigiro.com/openapi.json",
      "docs": "https://sigiro.com/docs/tutorials/quickstart",
      "basis": {
        "via": "declared",
        "source": "https://sigiro.com/.well-known/integrations.json"
      },
      "auth": {
        "status": "none",
        "basis": {
          "via": "declared",
          "source": "https://sigiro.com/.well-known/integrations.json"
        }
      }
    },
    {
      "type": "cli",
      "slug": "sigiro-cli",
      "name": "sigiro CLI",
      "command": "sigiro",
      "docs": "https://sigiro.com/docs/reference/cli",
      "packages": [
        {
          "registryType": "script",
          "identifier": "https://sigiro.com/install",
          "runtimeHint": "shell"
        },
        {
          "registryType": "oci",
          "identifier": "ghcr.io/sigiroai/sigiro"
        }
      ],
      "basis": {
        "via": "declared",
        "source": "https://sigiro.com/.well-known/integrations.json"
      },
      "auth": {
        "status": "required",
        "entries": [
          {
            "use": [
              {
                "id": "tenant_key",
                "mechanics": {
                  "source": "cli",
                  "command": "sigiro anomalies --key sk_<tenant>_<random>",
                  "env": ["SIGIRO_API_KEY"]
                }
              }
            ],
            "basis": {
              "via": "declared",
              "source": "https://sigiro.com/.well-known/integrations.json"
            }
          }
        ]
      }
    },
    {
      "type": "mcp",
      "slug": "sigiro-docs",
      "name": "sigiro documentation MCP server",
      "url": "https://sigiro.com/mcp",
      "transports": ["streamable-http"],
      "docs": "https://sigiro.com/docs",
      "basis": {
        "via": "declared",
        "source": "https://sigiro.com/.well-known/integrations.json"
      },
      "auth": {
        "status": "none",
        "basis": {
          "via": "declared",
          "source": "https://sigiro.com/.well-known/integrations.json"
        }
      }
    }
  ]
}
