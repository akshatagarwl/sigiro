{
  "version": 3,
  "summary": "sigiro reads OpenTelemetry and answers what changed and why: ranked findings, the suspect deploy, and a runnable SQL query on every row. Reachable as a hosted HTTP API, a self-hosted binary serving the same API with no credential, a CLI, and a public documentation MCP server.",
  "credentials": {
    "oauth_access_token": {
      "type": "oauth2",
      "label": "Better Auth OAuth access token",
      "setup": "Use the Better Auth/OAuth API to sign in and obtain an OAuth access token for the hosted service. Organizations are the tenants. Send it as Authorization: Bearer <oauth-access-token> for OTLP and API requests. Self-hosted Open mode needs no credential."
    }
  },
  "surfaces": [
    {
      "type": "http",
      "slug": "telemetry-api",
      "name": "sigiro hosted telemetry API",
      "url": "https://sigiro.com",
      "spec": "https://sigiro.com/openapi.json",
      "docs": "https://sigiro.com/docs/reference",
      "basis": {
        "via": "declared",
        "source": "https://sigiro.com/.well-known/integrations.json"
      },
      "auth": {
        "status": "required",
        "entries": [
          {
            "use": [
              {
                "id": "oauth_access_token",
                "mechanics": {
                  "source": "http",
                  "in": "header",
                  "headerName": "Authorization",
                  "scheme": "Bearer"
                }
              }
            ],
            "basis": {
              "via": "declared",
              "source": "https://sigiro.com/.well-known/integrations.json"
            }
          }
        ]
      }
    },
    {
      "type": "http",
      "slug": "self-hosted-api",
      "name": "sigiro self-hosted API (open mode)",
      "url": "https://<your-sigiro-host>:9999",
      "spec": "https://sigiro.com/openapi.json",
      "docs": "https://sigiro.com/docs/tutorials/quickstart",
      "basis": {
        "via": "declared",
        "source": "https://sigiro.com/.well-known/integrations.json"
      },
      "auth": {
        "status": "none",
        "basis": {
          "via": "declared",
          "source": "https://sigiro.com/.well-known/integrations.json"
        }
      }
    },
    {
      "type": "cli",
      "slug": "sigiro-cli",
      "name": "sigiro CLI",
      "command": "sigiro",
      "docs": "https://sigiro.com/docs/reference/cli",
      "packages": [
        {
          "registryType": "script",
          "identifier": "https://sigiro.com/install",
          "runtimeHint": "shell"
        },
        {
          "registryType": "oci",
          "identifier": "ghcr.io/sigiroai/sigiro"
        }
      ],
      "basis": {
        "via": "declared",
        "source": "https://sigiro.com/.well-known/integrations.json"
      },
      "auth": {
        "status": "required",
        "entries": [
          {
            "use": [
              {
                "id": "oauth_access_token",
                "mechanics": {
                  "source": "cli",
                  "command": "sigiro anomalies --token <oauth-access-token>",
                  "env": ["SIGIRO_ACCESS_TOKEN"]
                }
              }
            ],
            "basis": {
              "via": "declared",
              "source": "https://sigiro.com/.well-known/integrations.json"
            }
          }
        ]
      }
    },
    {
      "type": "mcp",
      "slug": "sigiro-docs",
      "name": "sigiro documentation MCP server",
      "url": "https://sigiro.com/mcp",
      "transports": ["streamable-http"],
      "docs": "https://sigiro.com/docs",
      "basis": {
        "via": "declared",
        "source": "https://sigiro.com/.well-known/integrations.json"
      },
      "auth": {
        "status": "none",
        "basis": {
          "via": "declared",
          "source": "https://sigiro.com/.well-known/integrations.json"
        }
      }
    }
  ]
}
