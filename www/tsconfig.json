{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // No `types` entry. It listed `bun-types`, which is not installed and is not
    // in package.json, so `tsc --noEmit` failed outright with TS2688 ("cannot
    // find type definition file") — a hard error, not a warning, and nothing ran
    // tsc so nobody saw it. Nothing in the checked set references `Bun.*`, and
    // `scripts/` (the only place that would) is excluded below, so the entry had
    // no job to do. If a checked file ever needs Bun globals, add `@types/bun`
    // to devDependencies and list `"bun"` here — not `bun-types`, which is the
    // pre-1.2 spelling.
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  // No `**/*.astro` here: `tsc` cannot parse that extension, and the tool that can
  // — `astro check` — does not run against the TypeScript in this repo. See the
  // `types:check` script for what that costs.
  "include": [
    ".astro/types.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "scripts"
  ]
}
