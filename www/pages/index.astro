---
import Landing from '@/components/Landing.astro';

/**
 * The English landing page, at `/`.
 *
 * The page itself lives in `src/components/Landing.astro`, which this and
 * `pages/[locale]/index.astro` both render. That is the whole point of the
 * split: one component, four locales, so a change to the page cannot land on
 * `/` and miss `/zh`.
 *
 * English is served here rather than at `/en`, so there is no redirect and the
 * canonical URL of the site's front door is unchanged. `hreflang="x-default"`
 * in `src/layouts/Base.astro` points here.
 */
---

<Landing locale="en" />
