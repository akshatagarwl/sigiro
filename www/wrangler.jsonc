{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sigiro-www",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  // The apex. Until 2026-08-01 sigiro.com was a Cloudflare Pages project of the
  // same name, still serving the pre-Next Vite SPA from four months earlier, and
  // `bun run deploy` shipped a Worker that nothing pointed at.
  //
  // Zone routes, not `custom_domain: true`. A custom domain makes Cloudflare own
  // the DNS record, so it refuses any hostname that already has one —
  // `Hostname 'sigiro.com' already has externally managed DNS records`. Detaching
  // the Pages project does NOT remove the records it created; they stay as
  // proxied A records, and deleting them needs a DNS-edit credential this
  // deploy path does not have. A route needs no such thing: it intercepts the
  // hostname at the edge ahead of whatever those records point at, which is why
  // the apex could come back without touching DNS at all.
  //
  // Both hostnames are listed because a route pattern matches one host.
  //
  // `workers_dev` is off. It was on as an escape hatch — the workers.dev URL is
  // the only way to reach a deploy whose routes are wrong — but the cost of
  // keeping it was a second public origin serving the identical site, with our
  // canonical tags, our sitemap and our OG tags on it. That is a duplicate of
  // sigiro.com that we published and never linked, and the escape hatch is one
  // line away whenever a route actually breaks.
  "workers_dev": false,
  "routes": [
    { "pattern": "sigiro.com/*", "zone_name": "sigiro.com" },
    { "pattern": "www.sigiro.com/*", "zone_name": "sigiro.com" }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  // Release artifacts, served by /dl/[...key].
  //
  // A bucket of its own, not `sigiro-prod`. That bucket holds tenant telemetry,
  // and /dl is an unauthenticated public route: putting both behind one binding
  // means one key-handling mistake in that route is a data leak rather than a
  // 404. Two buckets make that class of bug impossible instead of unlikely.
  //
  // The bucket itself stays private. Reads go through the Worker, so there is no
  // public bucket URL and no second hostname to add — which matters here,
  // because this deploy path has no DNS scope (see the routes note above).
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "sigiro-dl" }]
}
