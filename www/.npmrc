# tsconfig.json extends astro/tsconfigs/strict, but astro arrives through blume.
# Declaring it re-resolves the lockfile, which aube 2.2.16 cannot do for the
# vendored alchemy tarballs (ERR_AUBE_REGISTRY_ERROR). Review: declare astro
# once aube resolves transitive file: specifiers.
public-hoist-pattern=astro
