---
import { Effect } from 'effect';
import { FactoryLoopPlayer, type FactoryStage } from '@/components/factory-loop-player';
import { highlightSession } from '@/lib/highlight';
import { getCopy, type Locale } from '@/lib/site';

/**
 * The complete repair loop in one first-viewport terminal.
 *
 * The locale's `loop` stays the only transcript source. Shiki runs on the
 * server, then the player receives one trusted HTML string per line. A browser
 * without JavaScript gets the same five sessions below as static terminal
 * blocks.
 *
 * `locale` defaults to `en`, so `pages/index.astro` renders exactly as it did
 * before the landing page was localized and did not have to change.
 */
interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const LOOP = getCopy(locale).loop;

/**
 * The narrow-viewport owner labels, keyed by STAGE INDEX rather than by the
 * owner string.
 *
 * It used to be a `Record<string, string>` keyed on the English owner text
 * (`'your agent'` → `'agent'`), which silently stopped matching the moment the
 * owners were translated: every stage fell through to the `??` branch and
 * rendered its full label in the narrow slot. Indices are locale-independent,
 * and the array length is checked against the loop below so a stage added in
 * `site.shared.ts` cannot quietly lose its short form.
 *
 * The short forms are single words on purpose — this row is horizontally tight,
 * and a CJK short form is usually 2–3 glyphs, which fits where the English word
 * does.
 */
const SHORT_OWNER: Record<Locale, readonly string[]> = {
  en: ['sigiro', 'sigiro', 'agent', 'pipeline', 'memory'],
  zh: ['sigiro', 'sigiro', '智能体', '流水线', '记忆'],
  ja: ['sigiro', 'sigiro', 'エージェント', 'パイプライン', 'メモリ'],
  ko: ['sigiro', 'sigiro', '에이전트', '파이프라인', '메모리'],
};

if (SHORT_OWNER[locale].length !== LOOP.length) {
  throw new Error(
    `FactoryLoop: ${locale} has ${SHORT_OWNER[locale].length} short owners for ${LOOP.length} stages.`,
  );
}

const sessions = await Effect.runPromise(
  Effect.all(LOOP.map((stage) => highlightSession(stage.cmd, stage.out)), {
    concurrency: 'unbounded',
  }),
);

const stages: FactoryStage[] = LOOP.map((stage, index) => ({
  title: stage.title,
  owner: stage.owner,
  ownerShort: SHORT_OWNER[locale][index] ?? stage.owner,
  lines: sessions[index],
}));
---

<noscript>
  <ol class="space-y-5">
    {
      LOOP.map((stage, index) => (
        <li>
          <figure class="mat-panel rounded-[14px] p-[5px]">
            <figcaption class="meta flex h-8 items-center pl-2.5 text-ink-3">
              {stage.title} · {stage.owner}
            </figcaption>
            <div
              class="mat-well scroll-inset overflow-x-auto rounded-[9px] px-3.5 py-3 font-mono text-[12.5px] leading-[22px]"
            >
              <pre
                class="shiki whitespace-pre"
                set:html={sessions[index].map((line) => line.html).join('\n')}
              />
            </div>
          </figure>
        </li>
      ))
    }
  </ol>
</noscript>

<FactoryLoopPlayer stages={stages} client:visible />
