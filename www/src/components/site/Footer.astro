---
import { AskAI } from '@/components/site/ask-ai';
import { Logo } from '@/components/site/logo';
import { NAV, SOCIAL } from '@/lib/site';

/**
 * `AskAI` and `Logo` are React components rendered here with no `client:*`
 * directive, so nothing in this footer ships JavaScript. `AskAI` is seven links
 * built from a constant — there was never anything for the browser to do.
 */
---

<footer
  class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-hairline px-4 py-4 sm:px-5"
>
  {/*
    The mark and the ask-AI row are one group, so the row stays bottom-left beside
    the wordmark instead of drifting to the middle when the footer wraps.
    `gap-y-3` is what separates them once it does.
  */}
  <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
    <Logo size={13} />
    <AskAI />
  </div>

  {/*
    `*:` so every link gets the 24px hit area, including the one-character ones,
    without repeating the class five times.
  */}
  <nav
    aria-label="Footer"
    class="flex flex-wrap items-center gap-x-3 gap-y-1 *:inline-flex *:min-w-6 *:items-center *:rounded-[5px]"
  >
    {
      NAV.map((item) => (
        <a href={item.href} class="meta text-ink-3 hover:text-ink">
          {item.label.toLowerCase()}
        </a>
      ))
    }
    {
      SOCIAL.map((item) => (
        <a href={item.href} rel="me noopener" class="meta text-ink-3 hover:text-ink">
          {item.label.toLowerCase()}
        </a>
      ))
    }
    {/*
      Blume generates `/llms.txt` from the same content it renders, and it is at
      the site root now rather than behind a redirect to another hostname — which
      is where the convention says it belongs.
    */}
    <a href="/llms.txt" class="meta text-ink-3 hover:text-ink">llms.txt</a>
  </nav>
</footer>
