---
import { AskAI } from '@/components/site/ask-ai';
import { Logo } from '@/components/site/logo';
import { CALL, NAV, SOCIAL } from '@/lib/site';

/**
 * `AskAI` and `Logo` are React components rendered here with no `client:*`
 * directive, so nothing in this footer ships JavaScript. `AskAI` is seven links
 * built from a constant — there was never anything for the browser to do.
 *
 * Two call sites, and they need slightly different link sets. The landing page
 * mounts this in `src/layouts/Base.astro` and passes `surface="site"`; Blume
 * mounts it through the `Footer` layout slot in `components.ts` for `/docs/*`
 * and passes only its own props, so the default covers the docs.
 *
 * `surface` is an explicit prop rather than a check on the current path because
 * the slot receives no route (it gets `site`, `navigation` and `ui`), and
 * sniffing `Astro.url` here would put the same decision in a place where the
 * two mount points are not visible.
 */

type Props = {
  surface?: 'site' | 'docs';
};

const { surface = 'docs' } = Astro.props;

/**
 * A docs reader is already in the docs, so the `/docs` link is dead weight
 * there. `/docs/reference` still earns its place: it is a different page, not the one
 * they are on.
 */
const navItems = surface === 'docs' ? NAV.filter((item) => item.href !== '/docs') : NAV;
---

<footer
  class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-hairline px-4 py-4 sm:px-5"
>
  {/*
    The mark and the ask-AI row are one group, so the row stays bottom-left beside
    the wordmark instead of drifting to the middle when the footer wraps.
    `gap-y-3` is what separates them once it does.
  */}
  <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
    <Logo size={13} />
    <AskAI />
  </div>

  {/*
    `*:` so every link gets the 24px hit area without repeating the class five
    times.

    The hit area is a `min-h` plus `px-1`, not the `min-w-6` this used to carry.
    A 24px floor on *width* is invisible on `linkedin` and `llms.txt`, but `x` is
    one character about 7px wide, so it was padded to 24 and centred — adding
    ~8px of dead space on each side on top of the 12px `gap-x-3`, which read as a
    gap roughly three times wider beside the one-character label than anywhere
    else in the row. Sizing to the text keeps the rhythm even; the touch target
    stays 24px tall and gains a little horizontal padding.
  */}
  <nav
    aria-label="Footer"
    class="flex flex-wrap items-center gap-x-3 gap-y-1 *:inline-flex *:min-h-6 *:items-center *:rounded-[5px] *:px-1"
  >
    {
      navItems.map((item) => (
        <a href={item.href} class="meta text-ink-3 hover:text-ink">
          {item.label.toLowerCase()}
        </a>
      ))
    }
    {
      SOCIAL.map((item) => (
        <a href={item.href} rel="me noopener" class="meta text-ink-3 hover:text-ink">
          {item.label.toLowerCase()}
        </a>
      ))
    }
    {/*
      This footer renders on the docs too, via the `Footer` layout slot in
      `components.ts`. That is the only route to a person from a docs page: the
      landing page has the hero action, but a reader who installed sigiro and
      formed an opinion is in `/docs/*`, where Blume's shell has no such link.
    */}
    <a href={CALL.href} class="meta text-ink-3 hover:text-ink">
      {CALL.label.toLowerCase()}
    </a>
    {/*
      Blume generates `/llms.txt` from the same content it renders, and it is at
      the site root now rather than behind a redirect to another hostname — which
      is where the convention says it belongs.
    */}
    <a href="/llms.txt" class="meta text-ink-3 hover:text-ink">llms.txt</a>
  </nav>
</footer>
