---
import { Effect } from 'effect';
import { CopySource } from '@/components/site/copy-source';
import { highlight, type Lang } from '@/lib/highlight';

/**
 * Where polylane shows a screenshot of its UI, we show the thing sigiro actually
 * returns — this product has no screen. Shiki colours it here, at build time, so
 * no highlighting JavaScript reaches the browser.
 *
 * This absorbed `code-block.tsx`, which was "the one code-block shell for the
 * whole site: the landing page artifacts and every fence in the docs". The docs
 * left for Blume and took every other caller with them, so the shell was one
 * indirection with one user.
 *
 * The shape is the design language's: a `mat-panel` frame at radius 14 with
 * `p-[5px]`, holding a caption row and a `mat-well` at radius 9 — the code is cut
 * into the card, not bordered on it. 14 = 9 + 5, which is the whole reason those
 * two numbers are those two numbers.
 *
 * The caption is `.meta`: mono, 10.5px, the instrument voice. It is metadata about
 * the block, never prose.
 *
 * `highlight` returns an effect, so this is where it runs. It cannot fail — a
 * highlighter that will not start is caught inside `highlight`, logged, and
 * answered with the same block in plain escaped text — so `runPromise` here only
 * ever resolves.
 */

interface Props {
  title: string;
  meta?: string;
  code: string;
  lang: Lang;
}

const { title, meta, code, lang } = Astro.props;

const html = await Effect.runPromise(highlight(code, lang));
const caption = [title, meta].filter(Boolean).join(' · ') || lang;
---

<figure class="mat-panel my-6 rounded-[14px] p-[5px]">
  <figcaption class="flex h-8 items-center gap-2.5 pr-[3px] pl-2.5">
    <span class="meta min-w-0 flex-1 truncate text-ink-3">{caption}</span>
    <CopySource code={code} label={title} client:visible />
  </figcaption>

  {/*
    The type is set here and nowhere else. Shiki output, generated from literals in
    this repo.
  */}
  <div
    class="mat-well scroll-inset overflow-x-auto rounded-[9px] px-3.5 py-3 font-mono text-[12.5px] leading-[1.7]"
    set:html={html}
  />
</figure>
