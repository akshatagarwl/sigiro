---
import { CopySource } from '@/components/site/copy-source';
import { INSTALL_COMMAND, AGENT_PROMPT } from '@/lib/site.shared';

/**
 * The two ways a reader starts: run one command, or hand one paragraph to an
 * agent and let it do the running.
 *
 * Both are copy targets, because both are things you take somewhere else — a
 * terminal, or an agent's chat box. A command you have to select by hand is a
 * command that gets copied with half the prompt attached.
 *
 * The agent block is prose, not a code fence: it is text for a model to read,
 * and setting it in mono at 12.5px would say "shell command" about something
 * that is not one. It keeps the same panel and well so the two read as a pair.
 */
---

{/*
  No horizontal padding of its own: it renders inside the How section, which
  already carries the page's gutter, so its own `px-6` put "Start" 24px right of
  every other section's left edge. The heading uses the page's section-title
  ramp — medium, never semibold.
*/}
<section id="start" class="w-full py-14">
  <h2 class="text-[22px] leading-[1.2] font-medium tracking-[-0.03em] text-foreground sm:text-[27px]">Start</h2>

  {/*
    `items-start`: the two panels hold different amounts of text, and a grid
    stretches both to the taller one by default — which left ~150px of empty
    panel under the install command. Each panel is now as tall as its contents.
  */}
  <div class="mt-5 grid items-start gap-4 md:grid-cols-2">
    <figure class="border bg-card shadow-sm rounded-xl p-[5px]">
      <figcaption class="flex h-8 items-center gap-2.5 pr-[3px] pl-2.5">
        <span class="font-mono text-xs tabular-nums min-w-0 flex-1 truncate text-muted-foreground">install the CLI</span>
        <CopySource code={INSTALL_COMMAND} label="install command" client:visible />
      </figcaption>
      <div
        class="bg-muted overflow-x-auto rounded-lg px-3.5 py-3 font-mono text-[12.5px] leading-[1.7] text-muted-foreground"
      >
        {INSTALL_COMMAND}
      </div>
      <p class="px-2.5 pt-2.5 pb-1 text-[12.5px] leading-relaxed text-muted-foreground">
        Installs a single binary to <code class="font-mono">~/.local/bin/sigiro</code>. Reads the
        script first if you would rather: <a
          class="underline underline-offset-4 hover:text-foreground"
          href="/install">sigiro.com/install</a
        >.
      </p>
    </figure>

    <figure class="border bg-card shadow-sm rounded-xl p-[5px]">
      <figcaption class="flex h-8 items-center gap-2.5 pr-[3px] pl-2.5">
        <span class="font-mono text-xs tabular-nums min-w-0 flex-1 truncate text-muted-foreground">or give this to your agent</span>
        <CopySource code={AGENT_PROMPT} label="agent prompt" client:visible />
      </figcaption>
      <div
        class="bg-muted rounded-lg px-3.5 py-3 text-[12.5px] leading-[1.7] text-muted-foreground"
      >
        {AGENT_PROMPT}
      </div>
      <p class="px-2.5 pt-2.5 pb-1 text-[12.5px] leading-relaxed text-muted-foreground">
        Paste into Claude Code, Codex, Cursor or any MCP-capable agent. It installs sigiro, starts
        it, and registers <code class="font-mono">sigiro mcp</code> as an MCP server.
      </p>
    </figure>
  </div>
</section>
