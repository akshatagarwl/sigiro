---
import { AuthCard } from '@/components/auth/auth-form';
import Base from '@/layouts/Base.astro';

/**
 * The shell every auth page wears.
 *
 * These pages used to be HTML strings built in `auth/src/ui.ts` and served by
 * the auth Worker, with their own stylesheet and their own dark palette — a
 * second website living at the same origin. This mounts them on `Base`, so they
 * inherit the site header, the footer, Blume's fonts and the `blume:theme`
 * tokens: the same document as `/` and `/docs/*`.
 *
 * Everything inside the card is `AuthCard`, one React island built from stock
 * shadcn/ui components. It is a single component because the flow is a single state machine. An earlier cut
 * split it — a vanilla module toggling `hidden` on five `<div>`s, with a React
 * field bolted on top — which gave one flow two owners and two sources of truth
 * for which step the user is on.
 *
 * `client:load`, not `client:visible`: the card asks `/get-session` on mount to
 * decide what to render, and it is the only thing above the fold. Waiting for
 * an intersection would show an empty card to a reader who is already signed in.
 *
 * The element IDs inside `AuthCard` are load-bearing — `check-signup-browser.ts`
 * and `check-device-flow.ts` drive production by selector. Keeping them is what
 * lets those checks prove this port rather than be rewritten to match it.
 */

type AuthPage = 'sign-in' | 'sign-up' | 'device' | 'agent-device' | 'consent';

interface Props {
  page: AuthPage;
  title: string;
  intro: string;
}

const { page, title, intro } = Astro.props;
---

<Base title={`${title} · Sigiro`} description={intro} noindex>
  {/*
    A section, not a <main>: Base already renders `<main id="main">` around this
    slot, and a nested one is both invalid and inert — its `flex-1` resolved
    against a parent that was not a flex container, so the card could not
    stretch and the panel ended ~280px short of the viewport with dead space
    under the footer. `min-h-[calc(100dvh-13rem)]` is the panel height less the
    header, footer and the bezel gutter, which is what actually centres the card.
  */}
  <section
    class="mx-auto flex w-full max-w-[26rem] min-h-[calc(100dvh-13rem)] flex-col justify-center px-4 py-12"
    data-page={page}
  >
    <section
      class="border bg-card shadow-sm rounded-xl p-7"
      aria-labelledby="title"
    >
      {/*
        The heading lives inside the island, not here: the intro is
        phase-dependent copy, and leaving "Enter your email" above six code
        cells reads as broken. `title` and `intro` are still passed so the
        server renders the first step's heading and hydration does not swap it.
      */}
      <AuthCard page={page} title={title} intro={intro} client:load />
    </section>
    {/*
      Only about the email and code steps, so `AuthCard` shows it on those two
      phases and hides it on approval, consent and success screens (it toggles
      `hidden` by id). The server renders it visible only where the card starts
      on the email step, so a device page never flashes it.
    */}
    <p
      id="auth-footnote"
      class="mt-5 text-center text-[12px] text-muted-foreground"
      hidden={page !== 'sign-in' && page !== 'sign-up'}
    >
      Passwordless sign-in · 6-digit codes expire after five minutes
    </p>
  </section>
</Base>
