---
import 'blume:theme';
import Fonts from 'blume/components/layout/Fonts.astro';
import data from 'blume:data';
import SiteFooter from '@/components/site/Footer.astro';
import SiteHeader from '@/components/site/Header.astro';
import { jsonLd } from '@/lib/json-ld';
import { SITE } from '@/lib/site';

/**
 * The landing page's document, and the panel it sits in.
 *
 * This is deliberately NOT Blume's `PageLayout`. That layout exists for exactly
 * this job and would give us its chrome for free — but the chrome it gives is the
 * docs header, and the landing page keeps its own: the wordmark, the two nav
 * links, our theme toggle and the action, all set to DESIGN.md. So the docs pages
 * get Blume's shell and this page gets ours, and the two share the origin, the
 * fonts, the tokens and the theme rather than the markup.
 *
 * What this no longer carries, because Blume does it:
 *
 * - **Fonts.** `<Fonts>` below is Blume's own component, rendering the same
 *   `@font-face` and preload set the docs pages use, off the same two families.
 *   Our `astro:assets` `<Font>` calls and the `geist`-package Fonts config are
 *   gone: two pipelines for Geist would be two downloads of Geist.
 * - **The stylesheet.** `blume:theme` is the alias Blume declares for its generated
 *   Tailwind entry — the same sheet its own layouts pull in, with our `theme.css`
 *   inlined at the end of it. Importing it is not optional and was the one thing
 *   missing on the first build: writing our own shell instead of `PageLayout` opts
 *   out of everything the layout brings, so the landing page rendered in Times on a
 *   transparent background with no materials at all, while the docs beside it were
 *   fine. If this page ever loses its styling, look here first.
 * - **The theme.** `data-theme` is set pre-paint by the script below, using
 *   Blume's storage key, so the toggle needs no state of its own.
 *
 * `data-home` on `<html>` is what scopes the element-level rules in `theme.css`
 * to this page. Without it the landing page's body background and 13.5px type
 * would land on every docs page too.
 */

interface Props {
  /** Absolute or root-relative URL this page claims as canonical. */
  canonical?: string;
}

const { canonical = new URL(Astro.url.pathname, SITE.url).href } = Astro.props;

/** One @graph, cross-referenced, so an answer engine reads one entity not three. */
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      description: SITE.description,
      sameAs: ['https://x.com/SigiroAI', 'https://www.linkedin.com/company/sigiro'],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      description: SITE.description,
      publisher: { '@id': `${SITE.url}/#organization` },
      inLanguage: 'en',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${SITE.url}/#software`,
      name: SITE.name,
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Observability',
      operatingSystem: 'Linux, macOS',
      url: SITE.url,
      description: SITE.description,
      featureList: [
        'OpenTelemetry OTLP ingest for traces, logs, metrics and profiles',
        'Structured investigation responses for AI agents',
        'SQL questions with no proprietary query language',
        'Machine-readable API description at /openapi.json',
      ],
      publisher: { '@id': `${SITE.url}/#organization` },
    },
  ],
};

const og = new URL(SITE.ogImage, SITE.url).href;
---

<html lang="en" class="h-full" data-home>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />

    <title>{SITE.title}</title>
    <meta name="description" content={SITE.description} />
    <meta name="application-name" content={SITE.name} />
    <meta name="robots" content="index, follow" />

    <meta name="theme-color" content="#efeeea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141312" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE.url} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={SITE.title} />
    <meta property="og:description" content={SITE.description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.tagline} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@SigiroAI" />
    <meta name="twitter:title" content={SITE.title} />
    <meta name="twitter:description" content={SITE.description} />
    <meta name="twitter:image" content={og} />

    <Fonts cssVars={data.fontCssVars} />

    {/*
      The theme, before first paint.

      `is:inline` because it has to run where it is written. A bundled Astro script
      is deferred, and a deferred theme script is a flash of the wrong material on
      every load. Blume's own layouts carry the same script for the same reason.

      Key and attribute are Blume's — `blume-theme`, `data-theme` — so this page
      and a docs page read and write one preference. Under the old two-origin
      split they could not: storage is per-origin, and `terminal.tsx` documented
      that as the one thing genuinely lost when the docs moved out. It is back.

      This duplicates Blume's `THEME_INIT_SCRIPT` rather than importing it, and
      that is the nature of a pre-paint script: it cannot import a module, and a
      module cannot run before paint. The contract it has to match is two names.
    */}
    <script is:inline>
      try {
        const saved = localStorage.getItem('blume-theme');
        document.documentElement.dataset.theme =
          saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>

  <body class="flex min-h-full flex-col font-sans text-ink-2 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-[9px] focus:bg-ink focus:px-3 focus:py-2 focus:text-panel"
    >
      Skip to content
    </a>

    {/*
      Every page is a panel floating on the bezel with a gutter around it. The
      gutter is not spacing — it is the frame, and it is what tells you the panel
      is an object rather than the page itself.

      `overflow-clip` and not `overflow-hidden`: both clip to the 20px radius, but
      `hidden` makes this box a scroll container, and then every `position: sticky`
      inside it resolves against a box that cannot scroll and silently stops
      sticking. `clip` is not a scroll container, so the viewport stays the
      scrollport.
    */}
    <div class="flex flex-1 p-3 sm:p-5">
      <div class="mat-panel flex min-w-0 flex-1 flex-col overflow-clip rounded-[20px]">
        <SiteHeader />

        {/*
          The measure. The panel is as wide as the window, and a 1400px column of
          13.5px prose is not a reading measure — so the document inside it is
          centred and capped, and the section hairlines span the document rather
          than the panel.
        */}
        <main id="main" class="mx-auto w-full min-w-0 max-w-[996px]">
          <slot />
        </main>

        <SiteFooter surface="site" />
      </div>
    </div>

    <script type="application/ld+json" is:inline set:html={jsonLd(graph)} />
  </body>
</html>
