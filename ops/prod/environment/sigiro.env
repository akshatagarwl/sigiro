SIGIRO_DATA_DIR=/var/lib/sigiro/telemetry
SIGIRO_EXTENSION_DIR=/var/cache/sigiro/duckdb
RUST_LOG=info
SIGIRO_RETENTION_DAYS=7
SIGIRO_FLUSH_INTERVAL_SECS=1
SIGIRO_MAX_DISK_BYTES=4294967296
SIGIRO_DUCKDB_THREADS=1
SIGIRO_DUCKDB_MEMORY_LIMIT=512MB
SIGIRO_QUERY_TIMEOUT_SECONDS=10
SIGIRO_MAX_RESULT_ROWS=10000
SIGIRO_MAX_INGEST_BODY_BYTES=8388608
SIGIRO_AUTH_ISSUER=https://sigiro.com/api/auth
SIGIRO_AUTH_AUDIENCE=https://sigiro.com
SIGIRO_AUTH_JWKS_URL=https://sigiro.com/api/auth/jwks
