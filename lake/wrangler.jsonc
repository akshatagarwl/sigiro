{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Runtime-gate Worker only; test/runtime-gate-e2e.ts deploys it, runs the gate, and deletes it.
  "name": "sigiro-lake-runtime-gate",
  "main": "src/gate-worker.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "limits": { "cpu_ms": 300000 },
  "r2_buckets": [{ "binding": "LAKE", "bucket_name": "sigiro-lake-runtime-gate" }],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }]
}
