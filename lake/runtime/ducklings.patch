@@ -464,6 +464,27 @@ export async function init(options: InitOptions): Promise<void> {
   module = await initPromise;
 }
 
+/** Emscripten in-memory filesystem used by DuckDB paths such as `/tmp/catalog.ducklake`. */
+export interface DuckDBFileSystem {
+  readFile(path: string): Uint8Array;
+  writeFile(path: string, data: Uint8Array): void;
+  unlink(path: string): void;
+}
+
+/**
+ * Returns DuckDB's in-memory filesystem so callers can persist and restore database files
+ * (for example a DuckLake catalog) without remote attaches.
+ * @category Database
+ */
+export function fileSystem(): DuckDBFileSystem {
+  if (!module) {
+    throw new DuckDBError('DuckDB WASM not initialized. Call init() first.');
+  }
+  const fs = (module as unknown as { FS?: DuckDBFileSystem }).FS;
+  if (!fs) throw new DuckDBError('DuckDB WASM build does not export FS');
+  return fs;
+}
