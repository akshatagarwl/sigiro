{
  "$schema": "../www/node_modules/wrangler/config-schema.json",
  // Dashboard-only delivery. Keep this Worker and route aligned with
  // www/alchemy.run.ts; Alchemy continues to own the wider infrastructure.
  "name": "sigiro-dashboard",
  "account_id": "73035685fa8536f5c07b55b168868c71",
  "compatibility_date": "2026-07-24",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "sigiro.com/dashboard*",
      "zone_name": "sigiro.com",
    },
  ],
}
