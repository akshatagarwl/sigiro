{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && rm -rf dist && mkdir dist && mv out dist/dashboard",
    "typecheck": "tsc --noEmit",
    "test:auth": "node tests/auth-gate-browser.mjs",
    "test:auth:real": "node tests/auth-mode-real-browser.mjs",
    "test:values": "node --test tests/value.test.mjs tests/explorer-state.test.mjs",
    "test:graph": "node tests/graph-browser.mjs",
    "test:flow": "node tests/flow-browser.mjs",
    "test:dashboard": "node tests/dashboard-browser.mjs",
    "test:time-range": "node --test tests/time-window.test.mjs && node tests/time-range-browser.mjs && node tests/time-window-integration.mjs",
    "test:time-range:real": "node tests/time-window-real.mjs",
    "test:browser": "node tests/real-browser.mjs && node tests/filter-roundtrip.mjs && node tests/pagination-browser.mjs && node tests/fixture-browser.mjs"
  },
  "dependencies": {
    "@date-fns/utc": "2.1.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@noble/hashes": "2.4.0",
    "@tabler/icons-react": "3.51.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "@ui-sdk/core": "0.1.0-beta.5",
    "@ui-sdk/react": "0.1.0-beta.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.2",
    "d3-flame-graph": "5.0.0",
    "d3-selection": "3.0.1",
    "date-fns": "4.4.0",
    "echarts": "6.1.0",
    "lucide-react": "1.70.0",
    "motion": "14.10.1",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "nuqs": "2.10.2",
    "oauth4webapi": "3.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "superjson": "2.2.6",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/d3-selection": "3.0.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  },
  "packageManager": "aube@2.8.4"
}
