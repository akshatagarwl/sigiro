# Copy this file to .env and set every blank value.
# Do not commit .env or any file named below.

CELLD_BUCKET=
S3_ENDPOINT=
AWS_REGION=auto
CELLD_AWS_ACCESS_KEY_ID=
CELLD_AWS_SECRET_ACCESS_KEY=

# Host directories must exist and be owned by uid/gid 65532.
CELLD_STATE_DIR=
EXECUTOR_STATE_DIR=
EXECUTOR_WORKSPACE_DIR=
EXECUTOR_AUTH_DIR=

WORKER_ID=
WORKER_POLL_SECONDS=2
CLAUDE_BIN=claude
CODEX_BIN=codex

# Customer-owned files. The vars file contains only WORKER_TOKEN.
COORDINATOR_VARS_FILE=
WORKER_TOKEN_FILE=

CELLD_PUBLIC_PORT=8080
