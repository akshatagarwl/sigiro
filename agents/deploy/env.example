# Copy to .env. Pick a private repository this deployment is allowed to change.
SIGIRO_REPOSITORY=OWNER/REPO

# Ascii Box API key. Create one at https://box.ascii.dev.
BOX_API_KEY=

# Amazon S3 bucket for celld state. Create the bucket yourself; celld does not
# create it. The bucket must support conditional writes, which real Amazon S3
# does and MinIO does not.
CELLD_BUCKET=
AWS_REGION=

# Standard AWS credentials for the IAM identity celld uses to reach the bucket
# above. Supply the access key ID and secret access key for that identity;
# celld reads them from these two standard AWS environment variables and
# invents no credential mechanism of its own.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional loopback host ports; the services use fixed internal addresses.
SIGIRO_PORT=19999
SIGIRO_OTLP_PORT=14318
CELLD_PORT=18080
EVE_PORT=12000
