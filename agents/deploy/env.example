# Copy to .env. Pick a private repository this deployment is allowed to change.
SIGIRO_REPOSITORY=OWNER/REPO

# Ascii Box API key. Create one at https://box.ascii.dev.
BOX_API_KEY=

# S3 bucket for celld state. Create the bucket yourself; celld does not create
# it. The bucket must support conditional writes, because celld fences state
# ownership on them. Amazon S3 and Cloudflare R2 both do. MinIO Community does
# not, which is why it is not a supported store.
CELLD_BUCKET=

# Set S3_ENDPOINT only for an S3-compatible store that is not Amazon S3. Leave
# it empty for Amazon S3 and let the region select the endpoint.
# Cloudflare R2: https://ACCOUNT_ID.r2.cloudflarestorage.com, with region auto.
# A bucket created in a jurisdiction needs that jurisdiction's endpoint, for
# example ACCOUNT_ID.eu.r2.cloudflarestorage.com.
S3_ENDPOINT=
AWS_REGION=

# S3 credentials for the identity celld uses to reach the bucket above. celld
# reads these two standard environment variables and invents no credential
# mechanism of its own. For Amazon S3 these are an IAM access key pair. For
# Cloudflare R2 they are an R2 API token's Access Key ID and Secret Access Key,
# which you create in the R2 dashboard under Account Details, API Tokens,
# Manage. Wrangler cannot create them: it manages buckets, not credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional loopback host ports; the services use fixed internal addresses.
SIGIRO_PORT=19999
SIGIRO_OTLP_PORT=14318
CELLD_PORT=18080
EVE_PORT=12000
