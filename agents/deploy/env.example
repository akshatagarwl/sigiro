# Copy to .env. Pick a private repository and a project sandbox image already built on this Docker host.
SIGIRO_REPOSITORY=OWNER/REPO
EVE_SANDBOX_IMAGE=your-project-sandbox:local

# Local object-store credentials. Generate a password with: openssl rand -hex 32
MINIO_ROOT_USER=sigiro
MINIO_ROOT_PASSWORD=

# Optional loopback host ports; the services use fixed internal addresses.
SIGIRO_PORT=19999
SIGIRO_OTLP_PORT=14318
COORDINATOR_PORT=18080
EVE_PORT=12000
