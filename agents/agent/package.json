{
  "name": "@sigiro/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#world": "./world.ts"
  },
  "scripts": {
    "start": "eve start --host 127.0.0.1",
    "dev": "eve dev --host 127.0.0.1 --no-ui",
    "build": "eve build",
    "typecheck": "tsc --noEmit",
    "test:optimizer:github": "node --experimental-strip-types optimizer/github.integration.ts",
    "test:optimizer:leases": "node --experimental-strip-types optimizer/leases.integration.ts",
    "test:optimizer:workspace": "node --experimental-strip-types optimizer/workspace.integration.ts",
    "test:optimizer:checkpoint": "node --experimental-strip-types optimizer/checkpoint.integration.ts",
    "test:optimizer:cloudflare": "node --experimental-strip-types optimizer/cloudflare.integration.ts",
    "test:optimizer:cloudflare:live": "node --experimental-strip-types optimizer/cloudflare.live.integration.ts",
    "test:optimizer:flow": "node --experimental-strip-types optimizer/end-to-end.integration.ts",
    "start:optimizer-worker": "node --experimental-strip-types optimizer/main.ts"
  },
  "dependencies": {
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@rivet-dev/agentos": "0.2.21",
    "@rivet-dev/agentos-core": "0.2.21",
    "@rivet-dev/agentos-eve": "0.2.21",
    "@rivet-dev/vercel-world": "2.3.10",
    "@vercel/connect": "0.4.0",
    "@vercel/otel": "2.1.3",
    "ai": "7.0.26",
    "effect": "4.0.0-rc.115",
    "eve": "0.27.0",
    "pg": "8.23.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.16.0",
    "emulate": "0.12.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "aube@2.2.16"
}
