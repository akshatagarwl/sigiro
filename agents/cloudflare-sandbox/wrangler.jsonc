{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sigiro-optimizer-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    { "class_name": "Sandbox", "image": "./Dockerfile", "instance_type": "standard-1", "max_instances": 2 }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "Sandbox", "name": "Sandbox" },
      { "class_name": "WarmPool", "name": "WarmPool" }
    ]
  },
  "migrations": [
    { "new_sqlite_classes": ["Sandbox"], "tag": "v1" },
    { "new_sqlite_classes": ["WarmPool"], "tag": "v2" }
  ],
  "vars": { "SANDBOX_TRANSPORT": "rpc", "WARM_POOL_TARGET": "0", "WARM_POOL_MAX_INSTANCES": "2" },
  "preview_urls": false
}
