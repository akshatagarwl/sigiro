#!/usr/bin/env sh
# Filter: reads a list of paths on stdin, exits 0 if any of them can change what
# `cargo fmt`, `cargo clippy`, `cargo test`, `hawk` or `slop` would say.
#
# Used by pre-push so a www-only or docs-only change does not pay for a full
# workspace compile. The list is deliberately generous — a false
# positive costs a minute, a false negative pushes a broken tree.
#
#   justfile      the recipes themselves
#   hawk.toml     which crate hawk treats as production
#   scripts/      slop_audit.py lives here
#   clippy.toml   the disallowed-methods/macros ban lists and the argument
#                 ceiling. Added after it was found missing: clippy.toml decides
#                 what two `deny` lints in Cargo.toml actually reject, so a
#                 clippy.toml-only commit can turn a gate off — or on, breaking
#                 the build — while this filter said "no Rust in this commit"
#                 and skipped `just check` entirely. That is precisely the
#                 false negative the note above warns about.
exec grep -qE '\.rs$|(^|/)Cargo\.(toml|lock)$|^rust-toolchain|^\.cargo/|^hawk\.toml$|^clippy\.toml$|^justfile$|^scripts/'
