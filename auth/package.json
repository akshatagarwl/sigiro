{
  "name": "@sigiro/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "aube@2.2.16",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && tsx --test test/ui.ts",
    "lint": "oxlint --type-aware .",
    "schema:sql": "tsx scripts/generate-d1-sql.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test:email": "node --import tsx test/cloudflare-email-e2e.ts",
    "test:agent-e2e": "node --import tsx test/worker-agent-e2e.ts",
    "test": "aube run check && aube run test:email"
  },
  "dependencies": {
    "@better-auth/agent-auth": "0.6.2",
    "@better-auth/cimd": "1.7.5",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@better-auth/mcp": "1.7.5",
    "@better-auth/oauth-provider": "1.7.5",
    "@better-auth/passkey": "1.7.5",
    "better-auth": "1.7.5",
    "cloudflare": "7.1.0",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@auth/agent": "0.6.2",
    "@cloudflare/workers-types": "^5.20260919.1",
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "4.0.0-rc.115",
    "@types/node": "24.10.1",
    "jose": "6.2.3",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "wrangler": "^4.135.0"
  },
  "patchedDependencies": {
    "@auth/agent@0.6.2": "patches/@auth%2Fagent@0.6.2.patch"
  }
}
