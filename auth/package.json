{
  "name": "@sigiro/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit",
    "types": "wrangler types --env-file /dev/null",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down --volumes",
    "migrate": "bun src/migrate.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test:e2e": "bun test/e2e.ts",
    "test": "bun run types && bun run check && bun test/run.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.4",
    "@better-auth/mcp": "1.7.4",
    "@better-auth/oauth-provider": "1.7.4",
    "@better-auth/passkey": "1.7.4",
    "better-auth": "1.7.4",
    "effect": "4.0.0-rc.111",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "jose": "6.2.3",
    "typescript": "7.0.2",
    "wrangler": "4.131.2"
  }
}
