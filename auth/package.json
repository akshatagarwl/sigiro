{
  "name": "@sigiro/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down --volumes",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "test:e2e": "node --env-file-if-exists=.env --import tsx test/e2e.ts",
    "test": "bun run check && node --env-file-if-exists=.env --import tsx test/run.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.5",
    "@better-auth/mcp": "1.7.5",
    "@better-auth/oauth-provider": "1.7.5",
    "@better-auth/passkey": "1.7.5",
    "better-auth": "1.7.5",
    "pg": "8.16.3",
    "resend": "6.28.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "jose": "6.2.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
