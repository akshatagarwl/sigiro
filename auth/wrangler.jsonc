{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sigiro-auth",
  "main": "src/d1/worker.ts",
  "compatibility_date": "2026-09-01",
  // nodejs_compat is required: better-auth and its plugins reach for node:
  // builtins (crypto, buffer) through their dependency graph even on the
  // Workers build.
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sigiro-auth",
      // Filled in by `wrangler d1 create sigiro-auth`; the placeholder is
      // deliberate so a deploy against an unconfigured account fails loudly
      // rather than silently creating a second empty database.
      "database_id": "31f342ac-3169-4308-9a3f-178d82af9774"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://sigiro.com",
    "SIGIRO_RESOURCE": "https://sigiro.com",
    "EMAIL_FROM": "noreply@sigiro.com",
    "CLOUDFLARE_ACCOUNT_ID": "73035685fa8536f5c07b55b168868c71"
  },
  // Secrets (NEVER vars): BETTER_AUTH_SECRET, CLOUDFLARE_EMAIL_API_TOKEN.
  // Set with `wrangler secret put <NAME>`.
  //
  // A separate worker and database keep AUTH_TEST_OTP out of production.
  // End-to-end auth tests exercise the real Workers runtime.
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sigiro-auth-preview",
          "database_id": "503eb8c3-8e6d-4d03-bedd-10b2055a3cee"
        }
      ],
      "vars": {
        "ENVIRONMENT": "test",
        "AUTH_TEST_OTP": "123456",
        "BETTER_AUTH_URL": "https://sigiro-auth-preview.akshatag.workers.dev",
        "SIGIRO_RESOURCE": "https://sigiro-auth-preview.akshatag.workers.dev",
        "EMAIL_FROM": "noreply@sigiro.com",
        "CLOUDFLARE_ACCOUNT_ID": "73035685fa8536f5c07b55b168868c71"
      }
    }
  }
}
