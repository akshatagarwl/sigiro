{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sigiro-auth",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "auth.sigiro.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://auth.sigiro.com",
    "SIGIRO_RESOURCE": "https://api.sigiro.com",
    "EMAIL_FROM": "noreply@sigiro.com"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "08b1cbd37ed34288a1d91c8ad1f913e6"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@sigiro.com"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
