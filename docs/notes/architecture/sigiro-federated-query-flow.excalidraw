    {"type": "rectangle", "id": "p1_insight", "x": 800, "y": 115, "width": 280, "height": 70, "roundness": {"type": 3}, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "boundElements": [{"id": "t_p1_insight", "type": "text"}]},
    {"type": "text", "id": "t_p1_insight", "x": 810, "y": 125, "width": 260, "height": 50, "text": "Agent identifies: Machine #2\nhas anomalous error rate\n-> narrows investigation target", "fontSize": 16, "fontFamily": 1, "strokeColor": "#c92a2a", "textAlign": "center", "verticalAlign": "middle", "containerId": "p1_insight", "originalText": "Agent identifies: Machine #2\nhas anomalous error rate\n-> narrows investigation target", "autoResize": true},

