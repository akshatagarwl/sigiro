---
source: src/federation.rs
expression: parsed
---
version: v1
kind: Spicepod
name: sigiro-central
datasets:
  - name: sigiro_spans
    from: "ducklake:sigiro_spans"
    params:
      ducklake_connection_string: "<DATA_DIR>/default/catalog.sqlite"
    acceleration:
      enabled: true
      engine: duckdb
  - name: worker_alpha_spans
    from: "ducklake:sigiro_spans"
    params:
      ducklake_connection_string: /data/default/catalog.sqlite
  - name: worker_beta_spans
    from: "ducklake:sigiro_spans"
    params:
      ducklake_connection_string: /data2/default/catalog.sqlite
