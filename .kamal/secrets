# shellcheck shell=sh disable=SC2034
# Kamal-compatible secret exports. Production values stay encrypted with SOPS.
KAMAL_REGISTRY_PASSWORD=$(sops decrypt --input-type dotenv --output-type dotenv ops/prod/secrets.env.sops | ruby -rdotenv -e 'print Dotenv.parse("/dev/stdin").fetch(ARGV.fetch(0))' KAMAL_REGISTRY_PASSWORD)
SIGIRO_CATALOG_PASSWORD=$(sops decrypt --input-type dotenv --output-type dotenv ops/prod/secrets.env.sops | ruby -rdotenv -e 'print Dotenv.parse("/dev/stdin").fetch(ARGV.fetch(0))' SIGIRO_CATALOG_PASSWORD)
SIGIRO_AUTH_DB_TLS_CERT_B64=$(sops decrypt --input-type dotenv --output-type dotenv ops/prod/secrets.env.sops | ruby -rdotenv -e 'print Dotenv.parse("/dev/stdin").fetch(ARGV.fetch(0))' SIGIRO_AUTH_DB_TLS_CERT_B64)
SIGIRO_AUTH_DB_TLS_KEY_B64=$(sops decrypt --input-type dotenv --output-type dotenv ops/prod/secrets.env.sops | ruby -rdotenv -e 'print Dotenv.parse("/dev/stdin").fetch(ARGV.fetch(0))' SIGIRO_AUTH_DB_TLS_KEY_B64)
SIGIRO_AUTH_TUNNEL_TOKEN=$(sops decrypt --input-type dotenv --output-type dotenv ops/prod/secrets.env.sops | ruby -rdotenv -e 'print Dotenv.parse("/dev/stdin").fetch(ARGV.fetch(0))' SIGIRO_AUTH_TUNNEL_TOKEN)
SIGIRO_AUTH_DATABASE_URL=$(sops decrypt --input-type dotenv --output-type dotenv ops/prod/secrets.env.sops | ruby -rdotenv -e 'print Dotenv.parse("/dev/stdin").fetch(ARGV.fetch(0))' SIGIRO_AUTH_DATABASE_URL)
SIGIRO_ADMIN_TOKEN=$(sops decrypt --input-type dotenv --output-type dotenv ops/prod/secrets.env.sops | ruby -rdotenv -e 'print Dotenv.parse("/dev/stdin").fetch(ARGV.fetch(0))' SIGIRO_ADMIN_TOKEN)
BETTER_AUTH_SECRET=$(sops decrypt --input-type dotenv --output-type dotenv ops/prod/secrets.env.sops | ruby -rdotenv -e 'print Dotenv.parse("/dev/stdin").fetch(ARGV.fetch(0))' BETTER_AUTH_SECRET)
CLOUDFLARE_EMAIL_API_TOKEN=$(sops decrypt --input-type dotenv --output-type dotenv ops/prod/secrets.env.sops | ruby -rdotenv -e 'print Dotenv.parse("/dev/stdin").fetch(ARGV.fetch(0))' CLOUDFLARE_EMAIL_API_TOKEN)

[ -n "$KAMAL_REGISTRY_PASSWORD" ] || { printf '%s\n' "missing KAMAL_REGISTRY_PASSWORD" >&2; exit 1; }
[ -n "$SIGIRO_CATALOG_PASSWORD" ] || { printf '%s\n' "missing SIGIRO_CATALOG_PASSWORD" >&2; exit 1; }
[ -n "$SIGIRO_AUTH_DB_TLS_CERT_B64" ] || { printf '%s\n' "missing SIGIRO_AUTH_DB_TLS_CERT_B64" >&2; exit 1; }
[ -n "$SIGIRO_AUTH_DB_TLS_KEY_B64" ] || { printf '%s\n' "missing SIGIRO_AUTH_DB_TLS_KEY_B64" >&2; exit 1; }
[ -n "$SIGIRO_AUTH_TUNNEL_TOKEN" ] || { printf '%s\n' "missing SIGIRO_AUTH_TUNNEL_TOKEN" >&2; exit 1; }
[ -n "$SIGIRO_AUTH_DATABASE_URL" ] || { printf '%s\n' "missing SIGIRO_AUTH_DATABASE_URL" >&2; exit 1; }
[ -n "$SIGIRO_ADMIN_TOKEN" ] || { printf '%s\n' "missing SIGIRO_ADMIN_TOKEN" >&2; exit 1; }
[ -n "$BETTER_AUTH_SECRET" ] || { printf '%s\n' "missing BETTER_AUTH_SECRET" >&2; exit 1; }
[ -n "$CLOUDFLARE_EMAIL_API_TOKEN" ] || { printf '%s\n' "missing CLOUDFLARE_EMAIL_API_TOKEN" >&2; exit 1; }
