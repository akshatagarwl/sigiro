amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"

local rustInputs = List(
  "**/*.rs",
  "Cargo.toml",
  "Cargo.lock",
  "rust-toolchain.toml",
  ".cargo/**",
  "clippy.toml"
)

// rustfmt comes from the pinned toolchain: `nix develop`, or rustup reading
// rust-toolchain.toml.
local rustfmt = new Step {
  glob = rustInputs
  check = "cargo fmt --check"
  fix = "cargo fmt"
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ["rustfmt"] = rustfmt
    }
  }
}
