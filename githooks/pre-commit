#!/bin/bash
set -e

# ============================================================================
# Sigiro pre-commit hook — delegates to just for core gates.
# Skip: git commit --no-verify (emergency only)
# ============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

pass() { echo -e "${GREEN}==> $1${NC}"; }
fail() { echo -e "${RED}==> FAILED: $1${NC}"; exit 1; }

# ---- Core gate: just check -------------------------------------------------
just check || fail "just check"
pass "just check"

# ---- Optional: cargo deny (licenses, advisories, bans, sources) ------------
timeout 60 cargo deny check advisories licenses bans sources 2>/dev/null || \
  echo "SKIP: cargo deny (not installed or timed out)"
pass "cargo deny"

# ---- Optional: semgrep (Tiger Style rules, staged .rs only) ----------------
staged_rs=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs' || true)
if [ -n "$staged_rs" ]; then
  echo "$staged_rs" | xargs semgrep --config .semgrep/ --error --quiet || fail "semgrep"
else
  echo "(no staged .rs files — semgrep skipped)"
fi
pass "semgrep"

# ---- Optional: cargo-modules (orphans) -------------------------------------
orphans_out=$(cargo modules orphans --lib 2>/dev/null)
if [ -n "$orphans_out" ]; then
  echo "$orphans_out"
  fail "cargo-modules orphans"
fi
pass "cargo-modules orphans"

# ---- Optional: cargo +nightly udeps -----------------------------------------
timeout 120 rustup run nightly cargo udeps --all-targets 2>/dev/null || \
  echo "SKIP: cargo udeps (not installed or timed out)"
pass "cargo udeps"

# ---- Optional: cargo mutants (diff-only, staged changes) --------------------
if command -v cargo-mutants &>/dev/null; then
  timeout 300 cargo mutants --no-shuffle --in-diff <(git diff --cached) || fail "cargo mutants"
else
  echo "(cargo-mutants not installed — skipped)"
fi
pass "cargo mutants"

echo ""
echo -e "${GREEN}==> all checks passed${NC}"
